# ==========================================
# LocardX .gitattributes
# Consistent line endings and diff handling
# ==========================================

# Set default behavior: normalize text files to LF on checkout
* text=auto eol=lf

# ------------------------------------------
# Source Code (force LF)
# ------------------------------------------
*.rs text eol=lf diff=rust
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf

# ------------------------------------------
# Documentation & Configuration
# ------------------------------------------
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf

# ------------------------------------------
# Shell Scripts & Batch Files
# ------------------------------------------
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ------------------------------------------
# Binary Files (no text normalization)
# ------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.tar.gz binary
*.zip binary
*.7z binary
*.raw binary
*.dd binary
*.img binary
*.E01 binary
*.vmdk binary
*.vhd binary
*.vhdx binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
