# ==============================================================================
# LocardX - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and adjust settings for your local development setup.
# Never commit '.env' or real secrets to version control.
# ==============================================================================

# Application Environment Mode: development | test | production
LOCARDX_ENV=development

# Tracing and Logging Level: trace | debug | info | warn | error
LOCARDX_LOG_LEVEL=info

# Custom SQLite Database Storage Path
# If left commented or empty, LocardX defaults to standard OS app data path:
# Windows: %APPDATA%\LocardX\locardx.db
# Linux: ~/.local/share/locardx/locardx.db
# LOCARDX_DB_PATH=./locardx.db

# Custom Audit Log Storage Directory
# LOCARDX_AUDIT_DIR=./audit_logs

# Tauri Dev Server Host and Port
VITE_DEV_SERVER_PORT=1420
VITE_DEV_SERVER_HOST=localhost
